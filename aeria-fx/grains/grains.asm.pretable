; CYCLES_FORWARD_BRANCHES
; AERIA GRAINS -- a live granular processor (Balloon Shop GrainShifter,
; scaled down to one DSP56300 budget).
;
; The input, mono (L+R)/2, is recorded into the FX2 buffer as a 15870-word
; ring (360 ms; m = $3dfd, below the Sidechain window). Four grains: each a
; linearly interpolated read head with its own age (how far back), speed,
; triangle window, pan and gain, a quarter period apart; two staggered
; triangles sum to exactly 1.
;
;  SIZE  grain length 10 .. 300 ms (squared taper), shortened per block so
;        no grain can run across the record head or the ring's end at the
;        current speed (|age rate| * len <= 15772 samples)
;  DENS  grains 1 (gaps) .. 4 (dense); level normalised by 2/max(2, sum)
;  POS   where grains start: 0 = just now .. 127 = 350 ms back
;  SPRY  random start offset (up to +- half the ring) and random pan
;  PTCH  -24 .. +24 semitones (speed 2^(st/12))
;  MIX   0 = exact dry
;  FRZ   (page 2 slot 6) HOLD stops recording; grains play the frozen ring
;  REV   (page 2 slot 8) probability that a grain plays backwards
;
; Each grain latches speed/direction, length, start, pan and gain when it
; restarts (its window is 0 there), so knob moves never click a grain.
; Random: 24-bit LCG x*1664525 + $6ef35f (mod 2^24), drawn at restarts.
; A grain's age moves by adv - speed per sample (adv 1 live, 0 frozen); a
; grain already playing when FRZ flips keeps its latched rate to its end.
;
; r7: 00 base 01 ptr 02 clear 03 rnd 04/05 mix t/s 06 dage fwd 07 dage rev
;   08 inc (1/len) 09 len 0a centre 0b spread 0c rev threshold 0d adv
;   0e norm t 0f norm s 10..13 grain gains 14 pan reach 15 tmp
;   16 sum L 17 sum R 18 lo fwd 19 hi fwd 1a lo rev 1b hi rev 1c speed/8
;   1d/1e chosen lo/hi at a restart
;   20+8k grain k: +0 phase (-1..0) +1 inc +2 age +3 dage +4 gL +5 gR

init:
        move    #>$ffffff,m4
        move    r7,r4
        clr     a
        do      #64,>grizero
        move    a,x:(r4)+
grizero:
        nop     
        move    x:>$213,r4
        move    x:(r4),a
        move    a,x:(r7+$00)
        move    a,x:(r7+$01)
        move    #>$80,a
        move    a,x:(r7+$02)
        move    #>$2b5d1f,a
        move    a,x:(r7+$03)  ; LCG seed
        move    #>$800000,a
        move    a,x:(r7+$20)  ; staggered
        move    #>$006200,a
        move    a,x:(r7+$22)
        move    #>$a00000,a
        move    a,x:(r7+$28)  ; staggered
        move    #>$006200,a
        move    a,x:(r7+$2a)
        move    #>$c00000,a
        move    a,x:(r7+$30)  ; staggered
        move    #>$006200,a
        move    a,x:(r7+$32)
        move    #>$e00000,a
        move    a,x:(r7+$38)  ; staggered
        move    #>$006200,a
        move    a,x:(r7+$3a)
        rts     
proc:
        move    #>$ffffff,m4
        move    #>$1,n0
; speed/8 = 2^(st/12)/8 by the PITCH chain (Taylor 2^(x/8), three squarings)
        move    x:(r6+$4),a
        asl     #$2,a,a
        move    #>$600000,x0
        sub     x0,a
        move    a,x0
        move    #>$1d9304,y0
        mpy     y0,x0,a
        move    a,y0
        move    #>$00aaab,x0
        mpy     y0,x0,a
        add     #>$02aaab,a
        move    a,x0
        mpy     y0,x0,a
        add     #>$080000,a
        move    a,x0
        mpy     y0,x0,a
        add     #>$100000,a
        move    a,x0
        mpy     y0,x0,a
        add     #>$100000,a
        move    a,x0
        mpy     x0,x0,a
        asl     #$3,a,a
        move    a,x0
        mpy     x0,x0,a
        asl     #$3,a,a
        move    a,x0
        mpy     x0,x0,a
        asl     #$3,a,a
        move    a,x:(r7+$1c)
; adv (FRZ: page-2 slot 6)
        move    x:(r6+$c),a
        and     #>$ff0000,a
        move    #>$000200,b
        tst     a
        beq     grlive
        clr     b
grlive:
        move    b,x:(r7+$0d)  ; adv in A-units: 512 or 0
; dage fwd = adv - speed, rev = adv + speed (A-units)
        move    x:(r7+$1c),a
        asr     #$b,a,a  ; speed/16384
        move    a,x1
        sub     x1,b
        move    b,x:(r7+$06)
        move    x:(r7+$0d),b
        add     x1,b
        move    b,x:(r7+$07)
; len from SIZE (A-units)
        move    x:(r6),x0
        mpy     x0,x0,a
        move    a,x0
        move    #>$63ea00,y0
        mpy     y0,x0,a
        add     #>$037200,a
        move    a,x:(r7+$09)
; dmax = max(|dage fwd|, REV ? dage rev : 0); if dmax len > R: len = R / dmax
        move    x:(r7+$06),a
        abs     a
        move    x:(r6+$d),b
        and     #>$ff0000,b
        tst     b
        beq     grnorev
        move    x:(r7+$07),x0
        cmp     x0,a
        tlt     x0,a
grnorev:
        move    a,y1  ; dmax (A-units per sample)
        move    x:(r7+$09),x0
        mpy     x0,y1,a
        asl     #$e,a,a
        move    #>$7b3800,x0
        cmp     x0,a
        ble     grlenok
        move    y1,x0
        move    #>$0001ed,a
        andi    #$fe,ccr
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        move    a0,x:(r7+$09)
grlenok:
; inc = 1/len = (1/16384) / len_A
        move    x:(r7+$09),x0
        move    #>$000200,a
        andi    #$fe,ccr
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        move    a0,x:(r7+$08)
; centre (POS), spread and pan (SPRY), reverse threshold 2 REV - 1
        move    x:(r6+$2),x0
        move    #>$7b3800,y0
        mpy     y0,x0,a
        add     #>$006000,a
        move    a,x:(r7+$0a)
        move    x:(r6+$3),x0
        move    #>$3d9c00,y0
        mpy     y0,x0,a
        move    a,x:(r7+$0b)
        move    x:(r6+$3),a
        asr     a
        move    a,x:(r7+$14)
        move    x:(r6+$d),a
        and     #>$ff0000,a
        asl     a
        move    #>$800000,x0
        add     x0,a
        move    a,x:(r7+$0c)
; start bounds per direction: lo = M + max(0, -disp), hi = M + R - max(0, disp), disp = dage len
        move    x:(r7+$06),x0
        move    x:(r7+$09),y1
        mpy     x0,y1,a
        asl     #$e,a,a
        move    a,x1  ; disp
        move    #>$006000,b
        tst     a
        bge     grlo0
        sub     x1,b
grlo0:
        move    b,x:(r7+$18)
        move    #>$7b9800,b
        tst     a
        ble     grhi0
        sub     x1,b
grhi0:
        move    b,x:(r7+$19)
        move    x:(r7+$07),x0
        move    x:(r7+$09),y1
        mpy     x0,y1,a
        asl     #$e,a,a
        move    a,x1  ; disp
        move    #>$006000,b
        tst     a
        bge     grlo1
        sub     x1,b
grlo1:
        move    b,x:(r7+$1a)
        move    #>$7b9800,b
        tst     a
        ble     grhi1
        sub     x1,b
grhi1:
        move    b,x:(r7+$1b)
; DENS: t = 3 DENS / 4; g0 = 1, g2 = c(4t), g1 = c(4t - 1), g3 = c(4t - 2)
        move    #>$7fffff,a
        move    a,x:(r7+$10)
        move    x:(r6+$1),x0
        move    #>$600000,y0
        mpy     y0,x0,a
        move    a,x:(r7+$15)
        move    x:(r7+$15),a
        sub     #>$000000,a
        asl     #$2,a,a
        move    #>$0,x0
        tst     a
        tlt     x0,a
        move    #>$7fffff,x0
        cmp     x0,a
        tgt     x0,a
        move    a,x:(r7+$12)
        move    x:(r7+$15),a
        sub     #>$200000,a
        asl     #$2,a,a
        move    #>$0,x0
        tst     a
        tlt     x0,a
        move    #>$7fffff,x0
        cmp     x0,a
        tgt     x0,a
        move    a,x:(r7+$11)
        move    x:(r7+$15),a
        sub     #>$400000,a
        asl     #$2,a,a
        move    #>$0,x0
        tst     a
        tlt     x0,a
        move    #>$7fffff,x0
        cmp     x0,a
        tgt     x0,a
        move    a,x:(r7+$13)
; norm = 2 / max(2, sum): (1/8) / (max(2, sum)/4), x4 in the loop
        move    #>$200000,a
        move    x:(r7+$11),x0
        move    #>$200000,y0
        mac     y0,x0,a
        move    x:(r7+$12),x0
        move    #>$200000,y0
        mac     y0,x0,a
        move    x:(r7+$13),x0
        move    #>$200000,y0
        mac     y0,x0,a
        move    #>$400000,x0
        cmp     x0,a
        tlt     x0,a
        move    a,x0
        move    #>$100000,a
        andi    #$fe,ccr
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        div     x0,a
        move    a0,x:(r7+$0e)
; MIX (page 1 slot 5)
        move    x:(r6+$5),a
        move    #>$7f0000,x0
        cmp     x0,a
        bne     grmset
        move    #>$7fffff,a
grmset:
        move    a,x:(r7+$04)
        move    x:(r7+$04),a
        move    x:(r7+$05),b
        sub     b,a
        abs     a
        cmp     #>$000100,a
        bge     grmsnap
        move    x:(r7+$04),a
        move    a,x:(r7+$05)
grmsnap:
; bounded clearing (128 dry calls)
        move    x:(r7+$02),a
        tst     a
        beq     grready
        sub     #>$1,a
        move    a,x:(r7+$02)
        move    x:(r7+$0e),b
        move    b,x:(r7+$0f)
        move    x:(r7+$08),b
        move    b,x:(r7+$21)
        move    b,x:(r7+$29)
        move    b,x:(r7+$31)
        move    b,x:(r7+$39)
        cmp     #>$00007c,a
        bge     grnoclr
        asl     #$7,a,a
        move    x:(r7+$00),x0
        add     x0,a
        move    a,r4
        move    #>$3dfd,m4
        clr     a
        do      #128,>grclrlp
        move    a,y:(r4)+
grclrlp:
        nop     
        move    #>$ffffff,m4
grnoclr:
        rts     
grready:
        move    #>$3dfd,m4
        move    #>$3dfd,m5
        move    #>$ffffff,n4
        move    x:(r7+$01),r5
        do      n7,>grend
        move    x:(r7+$04),a
        move    x:(r7+$05),b
        sub     b,a
        asr     #$7,a,a
        add     a,b
        move    b,x:(r7+$05)
        move    x:(r7+$0e),a
        move    x:(r7+$0f),b
        sub     b,a
        asr     #$8,a,a
        add     a,b
        move    b,x:(r7+$0f)
; record at the head (age 0); frozen, the head does not advance, so this
; slot (also the oldest, which no grain reads) is all that is written
        move    x:(r0),a
        move    x:(r0+n0),x0
        add     x0,a
        asr     a
        move    a,y:(r5)
        clr     a
        move    a,x:(r7+$16)
        move    a,x:(r7+$17)
; ======== grain 0 ========
        move    x:(r7+$20),a
        move    x:(r7+$21),x0
        add     x0,a
        tst     a
        blt     grg0run
grg0new:
; ---- restart ----
        move    #>$800000,x0
        add     x0,a
        move    a,x:(r7+$15)
        move    x:(r7+$03),x0
        move    #>$19660d,y0
        mpy     y0,x0,a
        asr     a  ; a0 = low 24 bits of x*k
        move    a0,x0
        move    x0,a
        add     #>$6ef35f,a
        move    a1,x:(r7+$03)
        move    a1,x0
        move    x:(r7+$0c),b
        cmp     x0,b  ; threshold - rnd > 0: reverse
        move    x:(r7+$06),a
        move    x:(r7+$07),y1
        tgt     y1,a
        move    a,x:(r7+$23)
        move    x:(r7+$18),a
        move    x:(r7+$1a),y1
        tgt     y1,a
        move    a,x:(r7+$1d)  ; lo
        move    x:(r7+$19),a
        move    x:(r7+$1b),y1
        tgt     y1,a
        move    a,x:(r7+$1e)  ; hi
        move    x:(r7+$03),x0
        move    #>$19660d,y0
        mpy     y0,x0,a
        asr     a  ; a0 = low 24 bits of x*k
        move    a0,x0
        move    x0,a
        add     #>$6ef35f,a
        move    a1,x:(r7+$03)
        move    a1,x0
        move    x:(r7+$0b),y0
        mpy     y0,x0,a
        move    x:(r7+$0a),x1
        add     x1,a  ; start = centre + spread rnd
        move    x:(r7+$1d),x1
        cmp     x1,a
        tlt     x1,a
        move    x:(r7+$1e),x1
        cmp     x1,a
        tgt     x1,a
        move    a,x:(r7+$22)
; pan s = reach rnd; gL = g (1/2 + s), gR = g (1/2 - s)
        move    x:(r7+$14),y0
        mpy     y0,x0,a
        move    a,y1
        move    x:(r7+$10),x1
        move    #>$400000,a
        add     y1,a
        move    a,x0
        mpy     x1,x0,a
        move    a,x:(r7+$24)
        move    #>$400000,a
        sub     y1,a
        move    a,x0
        mpy     x1,x0,a
        move    a,x:(r7+$25)
        move    x:(r7+$08),a
        move    a,x:(r7+$21)
        move    x:(r7+$15),a
grg0run:
        move    a,x:(r7+$20)
; window w = 1 - 2 |phase + 1/2|
        add     #>$400000,a
        abs     a
        asl     a
        move    #>$7fffff,b
        sub     a,b
        move    b,y1
; age += dage; linear read at age (age >= M > 0)
        move    x:(r7+$22),a
        move    x:(r7+$23),x0
        add     x0,a
        move    a,x:(r7+$22)
        move    a1,b
        asr     #$9,a,a
        move    a1,a  ; whole samples
        and     #>$0001ff,b
        asl     #$e,b,b
        move    b1,y0  ; fraction
        neg     a
        move    a1,n5
        lua     (r5+n5),r4
        move    y:(r4)+n4,x0
        move    y:(r4),a
        sub     x0,a
        move    a,x1
        mpy     x1,y0,a
        add     x0,a
        move    a,x0
        mpy     x0,y1,a  ; s w
        move    a,x0
        move    x:(r7+$16),a
        move    x:(r7+$24),y1
        mac     x0,y1,a
        move    a,x:(r7+$16)
        move    x:(r7+$17),a
        move    x:(r7+$25),y1
        mac     x0,y1,a
        move    a,x:(r7+$17)
; ======== grain 1 ========
        move    x:(r7+$28),a
        move    x:(r7+$29),x0
        add     x0,a
        tst     a
        blt     grg1run
grg1new:
; ---- restart ----
        move    #>$800000,x0
        add     x0,a
        move    a,x:(r7+$15)
        move    x:(r7+$03),x0
        move    #>$19660d,y0
        mpy     y0,x0,a
        asr     a  ; a0 = low 24 bits of x*k
        move    a0,x0
        move    x0,a
        add     #>$6ef35f,a
        move    a1,x:(r7+$03)
        move    a1,x0
        move    x:(r7+$0c),b
        cmp     x0,b  ; threshold - rnd > 0: reverse
        move    x:(r7+$06),a
        move    x:(r7+$07),y1
        tgt     y1,a
        move    a,x:(r7+$2b)
        move    x:(r7+$18),a
        move    x:(r7+$1a),y1
        tgt     y1,a
        move    a,x:(r7+$1d)  ; lo
        move    x:(r7+$19),a
        move    x:(r7+$1b),y1
        tgt     y1,a
        move    a,x:(r7+$1e)  ; hi
        move    x:(r7+$03),x0
        move    #>$19660d,y0
        mpy     y0,x0,a
        asr     a  ; a0 = low 24 bits of x*k
        move    a0,x0
        move    x0,a
        add     #>$6ef35f,a
        move    a1,x:(r7+$03)
        move    a1,x0
        move    x:(r7+$0b),y0
        mpy     y0,x0,a
        move    x:(r7+$0a),x1
        add     x1,a  ; start = centre + spread rnd
        move    x:(r7+$1d),x1
        cmp     x1,a
        tlt     x1,a
        move    x:(r7+$1e),x1
        cmp     x1,a
        tgt     x1,a
        move    a,x:(r7+$2a)
; pan s = reach rnd; gL = g (1/2 + s), gR = g (1/2 - s)
        move    x:(r7+$14),y0
        mpy     y0,x0,a
        move    a,y1
        move    x:(r7+$11),x1
        move    #>$400000,a
        add     y1,a
        move    a,x0
        mpy     x1,x0,a
        move    a,x:(r7+$2c)
        move    #>$400000,a
        sub     y1,a
        move    a,x0
        mpy     x1,x0,a
        move    a,x:(r7+$2d)
        move    x:(r7+$08),a
        move    a,x:(r7+$29)
        move    x:(r7+$15),a
grg1run:
        move    a,x:(r7+$28)
; window w = 1 - 2 |phase + 1/2|
        add     #>$400000,a
        abs     a
        asl     a
        move    #>$7fffff,b
        sub     a,b
        move    b,y1
; age += dage; linear read at age (age >= M > 0)
        move    x:(r7+$2a),a
        move    x:(r7+$2b),x0
        add     x0,a
        move    a,x:(r7+$2a)
        move    a1,b
        asr     #$9,a,a
        move    a1,a  ; whole samples
        and     #>$0001ff,b
        asl     #$e,b,b
        move    b1,y0  ; fraction
        neg     a
        move    a1,n5
        lua     (r5+n5),r4
        move    y:(r4)+n4,x0
        move    y:(r4),a
        sub     x0,a
        move    a,x1
        mpy     x1,y0,a
        add     x0,a
        move    a,x0
        mpy     x0,y1,a  ; s w
        move    a,x0
        move    x:(r7+$16),a
        move    x:(r7+$2c),y1
        mac     x0,y1,a
        move    a,x:(r7+$16)
        move    x:(r7+$17),a
        move    x:(r7+$2d),y1
        mac     x0,y1,a
        move    a,x:(r7+$17)
; ======== grain 2 ========
        move    x:(r7+$30),a
        move    x:(r7+$31),x0
        add     x0,a
        tst     a
        blt     grg2run
grg2new:
; ---- restart ----
        move    #>$800000,x0
        add     x0,a
        move    a,x:(r7+$15)
        move    x:(r7+$03),x0
        move    #>$19660d,y0
        mpy     y0,x0,a
        asr     a  ; a0 = low 24 bits of x*k
        move    a0,x0
        move    x0,a
        add     #>$6ef35f,a
        move    a1,x:(r7+$03)
        move    a1,x0
        move    x:(r7+$0c),b
        cmp     x0,b  ; threshold - rnd > 0: reverse
        move    x:(r7+$06),a
        move    x:(r7+$07),y1
        tgt     y1,a
        move    a,x:(r7+$33)
        move    x:(r7+$18),a
        move    x:(r7+$1a),y1
        tgt     y1,a
        move    a,x:(r7+$1d)  ; lo
        move    x:(r7+$19),a
        move    x:(r7+$1b),y1
        tgt     y1,a
        move    a,x:(r7+$1e)  ; hi
        move    x:(r7+$03),x0
        move    #>$19660d,y0
        mpy     y0,x0,a
        asr     a  ; a0 = low 24 bits of x*k
        move    a0,x0
        move    x0,a
        add     #>$6ef35f,a
        move    a1,x:(r7+$03)
        move    a1,x0
        move    x:(r7+$0b),y0
        mpy     y0,x0,a
        move    x:(r7+$0a),x1
        add     x1,a  ; start = centre + spread rnd
        move    x:(r7+$1d),x1
        cmp     x1,a
        tlt     x1,a
        move    x:(r7+$1e),x1
        cmp     x1,a
        tgt     x1,a
        move    a,x:(r7+$32)
; pan s = reach rnd; gL = g (1/2 + s), gR = g (1/2 - s)
        move    x:(r7+$14),y0
        mpy     y0,x0,a
        move    a,y1
        move    x:(r7+$12),x1
        move    #>$400000,a
        add     y1,a
        move    a,x0
        mpy     x1,x0,a
        move    a,x:(r7+$34)
        move    #>$400000,a
        sub     y1,a
        move    a,x0
        mpy     x1,x0,a
        move    a,x:(r7+$35)
        move    x:(r7+$08),a
        move    a,x:(r7+$31)
        move    x:(r7+$15),a
grg2run:
        move    a,x:(r7+$30)
; window w = 1 - 2 |phase + 1/2|
        add     #>$400000,a
        abs     a
        asl     a
        move    #>$7fffff,b
        sub     a,b
        move    b,y1
; age += dage; linear read at age (age >= M > 0)
        move    x:(r7+$32),a
        move    x:(r7+$33),x0
        add     x0,a
        move    a,x:(r7+$32)
        move    a1,b
        asr     #$9,a,a
        move    a1,a  ; whole samples
        and     #>$0001ff,b
        asl     #$e,b,b
        move    b1,y0  ; fraction
        neg     a
        move    a1,n5
        lua     (r5+n5),r4
        move    y:(r4)+n4,x0
        move    y:(r4),a
        sub     x0,a
        move    a,x1
        mpy     x1,y0,a
        add     x0,a
        move    a,x0
        mpy     x0,y1,a  ; s w
        move    a,x0
        move    x:(r7+$16),a
        move    x:(r7+$34),y1
        mac     x0,y1,a
        move    a,x:(r7+$16)
        move    x:(r7+$17),a
        move    x:(r7+$35),y1
        mac     x0,y1,a
        move    a,x:(r7+$17)
; ======== grain 3 ========
        move    x:(r7+$38),a
        move    x:(r7+$39),x0
        add     x0,a
        tst     a
        blt     grg3run
grg3new:
; ---- restart ----
        move    #>$800000,x0
        add     x0,a
        move    a,x:(r7+$15)
        move    x:(r7+$03),x0
        move    #>$19660d,y0
        mpy     y0,x0,a
        asr     a  ; a0 = low 24 bits of x*k
        move    a0,x0
        move    x0,a
        add     #>$6ef35f,a
        move    a1,x:(r7+$03)
        move    a1,x0
        move    x:(r7+$0c),b
        cmp     x0,b  ; threshold - rnd > 0: reverse
        move    x:(r7+$06),a
        move    x:(r7+$07),y1
        tgt     y1,a
        move    a,x:(r7+$3b)
        move    x:(r7+$18),a
        move    x:(r7+$1a),y1
        tgt     y1,a
        move    a,x:(r7+$1d)  ; lo
        move    x:(r7+$19),a
        move    x:(r7+$1b),y1
        tgt     y1,a
        move    a,x:(r7+$1e)  ; hi
        move    x:(r7+$03),x0
        move    #>$19660d,y0
        mpy     y0,x0,a
        asr     a  ; a0 = low 24 bits of x*k
        move    a0,x0
        move    x0,a
        add     #>$6ef35f,a
        move    a1,x:(r7+$03)
        move    a1,x0
        move    x:(r7+$0b),y0
        mpy     y0,x0,a
        move    x:(r7+$0a),x1
        add     x1,a  ; start = centre + spread rnd
        move    x:(r7+$1d),x1
        cmp     x1,a
        tlt     x1,a
        move    x:(r7+$1e),x1
        cmp     x1,a
        tgt     x1,a
        move    a,x:(r7+$3a)
; pan s = reach rnd; gL = g (1/2 + s), gR = g (1/2 - s)
        move    x:(r7+$14),y0
        mpy     y0,x0,a
        move    a,y1
        move    x:(r7+$13),x1
        move    #>$400000,a
        add     y1,a
        move    a,x0
        mpy     x1,x0,a
        move    a,x:(r7+$3c)
        move    #>$400000,a
        sub     y1,a
        move    a,x0
        mpy     x1,x0,a
        move    a,x:(r7+$3d)
        move    x:(r7+$08),a
        move    a,x:(r7+$39)
        move    x:(r7+$15),a
grg3run:
        move    a,x:(r7+$38)
; window w = 1 - 2 |phase + 1/2|
        add     #>$400000,a
        abs     a
        asl     a
        move    #>$7fffff,b
        sub     a,b
        move    b,y1
; age += dage; linear read at age (age >= M > 0)
        move    x:(r7+$3a),a
        move    x:(r7+$3b),x0
        add     x0,a
        move    a,x:(r7+$3a)
        move    a1,b
        asr     #$9,a,a
        move    a1,a  ; whole samples
        and     #>$0001ff,b
        asl     #$e,b,b
        move    b1,y0  ; fraction
        neg     a
        move    a1,n5
        lua     (r5+n5),r4
        move    y:(r4)+n4,x0
        move    y:(r4),a
        sub     x0,a
        move    a,x1
        mpy     x1,y0,a
        add     x0,a
        move    a,x0
        mpy     x0,y1,a  ; s w
        move    a,x0
        move    x:(r7+$16),a
        move    x:(r7+$3c),y1
        mac     x0,y1,a
        move    a,x:(r7+$16)
        move    x:(r7+$17),a
        move    x:(r7+$3d),y1
        mac     x0,y1,a
        move    a,x:(r7+$17)
; ---- out = sum * norm * 8 (norm word = 1/(2 max(2,sum)), pans carry 1/2) ----
        move    x:(r7+$16),x0
        move    x:(r7+$0f),y1
        mpy     x0,y1,a
        asl     #$3,a,a
        move    x:(r7+$05),y1
        move    x:(r0),b
        sub     b,a
        asr     a
        move    a,x0
        mpy     x0,y1,a
        asl     a
        add     b,a
        move    a,x:(r0)+
        move    x:(r7+$17),x0
        move    x:(r7+$0f),y1
        mpy     x0,y1,a
        asl     #$3,a,a
        move    x:(r7+$05),y1
        move    x:(r0),b
        sub     b,a
        asr     a
        move    a,x0
        mpy     x0,y1,a
        asl     a
        add     b,a
        move    a,x:(r0)+
; advance the head by adv (0 when frozen)
        move    x:(r7+$0d),a
        asr     #$9,a,a
        move    a1,n5
        nop     
        move    (r5)+n5
grend:
        nop     
        move    r5,x:(r7+$01)
        move    #>$ffffff,m4
        move    #>$ffffff,m5
        rts     
